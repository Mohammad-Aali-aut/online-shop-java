@startuml
skinparam shadowing false

node "Local workstation" as workstation <<device>> {
  node "Terminal" as terminal
  node "Java 21 JVM" as jvm <<executionEnvironment>> {
    artifact "target/classes" as classes
  }
  terminal -- jvm : System.in / System.out
}

component "Online Shop" as app
classes ..> app : <<manifest>>

note right of classes
  org.example.Main is the entry point.
  ConcurrentHashMap stores live in this JVM.
end note
@enduml
